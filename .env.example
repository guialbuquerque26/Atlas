# ============================================================
# ATLAS - variáveis de ambiente (copie para .env e ajuste)
# ============================================================

# ---- Provedor de LLM: ollama | huggingface ----
ATLAS_LLM_PROVIDER=ollama
# 127.0.0.1 e não localhost: no Windows localhost tenta IPv6 (::1) primeiro e
# o Ollama só escuta em IPv4, custando ~2s de timeout na primeira conexão.
ATLAS_OLLAMA_HOST=http://127.0.0.1:11434

# Tempo que o Ollama segura o modelo na memória após a última chamada.
# Curto demais faz o modelo de embeddings recarregar a cada turno (~2s perdidos).
ATLAS_OLLAMA_KEEP_ALIVE=30m

# Modelo de texto (raciocínio, chat, síntese)
ATLAS_TEXT_MODEL=qwen2.5:7b-instruct

# Modelo multimodal (imagens e frames de vídeo)
ATLAS_VISION_MODEL=qwen2.5vl:7b

# Modelo de embeddings (memória vetorial)
ATLAS_EMBED_MODEL=nomic-embed-text

# ---- Geração ----
ATLAS_TEMPERATURE=0.4
ATLAS_MAX_TOKENS=2048
ATLAS_CONTEXT_WINDOW=8192

# ---- Memória (RAG) ----
# Corte de similaridade para usar uma lembrança (0.70 calibrado p/ nomic-embed-text)
ATLAS_MEMORIA_LIMIAR_SIMILARIDADE=0.70
ATLAS_MEMORIA_MAX_CHARS=1000
ATLAS_MEMORIA_K=5

# ---- Busca na internet ----
ATLAS_SEARCH_ENABLED=true
ATLAS_SEARCH_PROVIDER=duckduckgo
ATLAS_SEARCH_MAX_RESULTS=5
ATLAS_SEARCH_FETCH_PAGES=true

# Tempo máximo para baixar cada página (segundos)
ATLAS_SEARCH_TIMEOUT_S=8.0

# ---- Vídeo ----
ATLAS_VIDEO_MAX_FRAMES=12
ATLAS_VIDEO_SCENE_THRESHOLD=12.0

# Frames enviados por chamada ao modelo de visão (1 desliga o agrupamento)
ATLAS_VIDEO_LOTE_FRAMES=4

# ---- Servidor ----
ATLAS_API_HOST=127.0.0.1
ATLAS_API_PORT=8000
ATLAS_UI_PORT=7860

# ---- Produção ----
# Chamadas ao modelo em voo. A GPU serializa: valores altos só engordam a fila.
ATLAS_MAX_INFERENCIAS=2
ATLAS_ADMISSAO_TIMEOUT_S=2.0
# Retry de falhas transitórias do Ollama
ATLAS_OLLAMA_TENTATIVAS=3
ATLAS_OLLAMA_BACKOFF_S=0.5
# Disjuntor: após N falhas seguidas, falha na hora durante a pausa
ATLAS_OLLAMA_CIRCUITO_FALHAS=3
ATLAS_OLLAMA_CIRCUITO_PAUSA_S=20.0
# Timeouts por operação
ATLAS_OLLAMA_TIMEOUT_TEXTO_S=120.0
ATLAS_OLLAMA_TIMEOUT_VISAO_S=300.0
ATLAS_OLLAMA_TIMEOUT_EMBED_S=60.0
# Sessões vivas em memória (o histórico é durável no SQLite)
ATLAS_MAX_SESSOES_MEMORIA=200
# Segurança: vazio = sem auth e sem origem externa (só para uso local)
ATLAS_API_TOKEN=
ATLAS_CORS_ORIGINS=
ATLAS_UPLOAD_MAX_MB=50.0

# Abrir o navegador automaticamente ao subir a interface
ATLAS_UI_ABRIR_NAVEGADOR=true

# ---- Diretórios (relativos à raiz do projeto) ----
ATLAS_DATA_DIR=data
